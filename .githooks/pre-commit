#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

if ! git diff --quiet --ignore-submodules --; then
    echo 'Commit blocked: stage or stash unstaged tracked changes before running checks.' >&2
    exit 1
fi

untracked=$(git ls-files --others --exclude-standard -- '*/src/**' '*.gradle' '*.gradle.kts' 'gradle.properties' 'gradle/**' '.githooks/**' 'scripts/**')
if [ -n "$untracked" ]; then
    printf 'Commit blocked: stage or move untracked build inputs first:\n%s\n' "$untracked" >&2
    exit 1
fi

./gradlew --console=plain format

if ! git diff --quiet --ignore-submodules --; then
    echo 'Commit blocked: formatting changed files. Review the diff, stage the changes, and retry.' >&2
    exit 1
fi

./gradlew --console=plain lint build
